  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0"
  },
  "jest": {
    "reporters": [
      "default",
      "jest-junit"
    ],
